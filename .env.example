# ===== Server =====
PORT=4000
NODE_ENV=production
CLIENT_URL=http://localhost:3001
JWT_SECRET=change_this_to_a_random_string
# Base URL of the app (used in password reset links)
APP_URL=http://localhost:3001

# ===== Password Reset Email (Gmail SMTP) =====
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), NOT your normal password.
# If not set, reset links are logged to the server console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ===== WebRTC TURN (Cloudflare free) =====
# Cloudflare Dashboard -> Account -> Calls -> Turn -> AUTH_SECRET
TURN_AUTH_SECRET=your_cloudflare_turn_auth_secret

# ===== Push Notifications =====
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:admin@co-patner.com

# ===== Firebase (Frontend) =====
# These go in apps/web/.env.local
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ===== Push Notifications (Frontend) =====
# Same VAPID_PUBLIC_KEY as above, goes in apps/web/.env.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key
